# ACF-Docs environment

# AI Voice Narration (optional).
# When set, the "Listen" control on the promoted Site B Parts uses OpenAI TTS
# (server-side via /api/narration) for high-quality narration. When unset, the
# control degrades gracefully to the browser's built-in Web Speech voice, and the
# site builds and runs exactly as before. The key is read server-side only and is
# never exposed to the client.
OPENAI_API_KEY=

# Optional: narration voice tuning. All three are read server-side only.
#
#   NARRATION_TTS_MODEL   — defaults to the pinned snapshot `gpt-4o-mini-tts-2025-12-15`
#                           (reported ~35% lower word error rate than the original
#                           release). Pinned so stored audio never changes voice
#                           underneath readers. If OpenAI ever refuses it, the route
#                           retries once on the floating alias `gpt-4o-mini-tts`.
#                           LEAVE THIS UNSET unless moving to a newer model on
#                           purpose; an old value set here overrides the default.
#                           The legacy `tts-1` / `tts-1-hd` models sound robotic.
#   NARRATION_TTS_VOICE   — defaults to `ash`: smooth, confident, male (chosen on
#                           listening; cedar and onyx were rejected). Any gpt-4o-mini-tts
#                           voice works: alloy · ash · ballad · coral · echo · fable ·
#                           onyx · nova · sage · shimmer · verse · marin · cedar.
#                           LEAVE UNSET to use ash; a value here (e.g. an old
#                           `nova`) overrides it. To audition a voice without
#                           changing anything, open a Part with ?voice=<name>.
#   NARRATION_TTS_INSTRUCTIONS — steers *how* the narrator reads (pace, tone, emphasis).
#                           A calm, warm, authoritative default is built in; override
#                           only to retune delivery. Ignored by legacy tts-1 models.
NARRATION_TTS_MODEL=
NARRATION_TTS_VOICE=
NARRATION_TTS_INSTRUCTIONS=

# Persistent narration store (strongly recommended). Connect a Vercel Blob store
# to this project (Vercel → Storage → Blob → Connect) and Vercel sets this for
# you. Every generated segment is then kept under a hash of its exact text,
# model, voice and instructions, so readers hear stored audio instantly and a
# docs edit regenerates only the segments whose text changed. The workflow
# .github/workflows/narration-warm.yml pre-renders after each production deploy.
BLOB_READ_WRITE_TOKEN=

# Optional: restrict who can POST to /api/narration (cost guard for the funded key).
# By default the endpoint only accepts same-origin requests from your own pages, so
# no value is needed in the common single-domain setup. Set this to a comma-separated
# list of extra allowed hosts/origins only if the docs and the API live on different
# domains (e.g. a custom domain in front of a *.vercel.app deployment).
#   NARRATION_ALLOWED_ORIGINS=docs.example.com,https://acf-docs.vercel.app
NARRATION_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Diagnosing "the Listen button sounds robotic again"
# -----------------------------------------------------------------------------
# Every way the premium voice can fail sounds identical: the button still works
# and the reader hears the browser's built-in Web Speech voice. To find out
# which one it is, open the deployed site and check the capability endpoint —
# it is a cheap GET, generates no audio, and spends nothing:
#
#     curl -s https://<your-docs-host>/api/narration | jq
#
#   { "available": false }                → OPENAI_API_KEY is not set on THIS
#                                            project (the docs site and the app
#                                            are separate deployments with
#                                            separate env vars)
#   { "available": true, "configWarning": "…" }
#                                        → the key is fine but NARRATION_TTS_VOICE
#                                            or NARRATION_TTS_MODEL is wrong
#   { "available": true, "model": "tts-1" }
#                                        → pinned to the legacy model, which
#                                            ignores the delivery instructions
#                                            and is the robotic-sounding one
#   429 on generation, quotaExhausted    → the OpenAI BALANCE is empty (auto-reload
#                                            can fail silently). The capability check
#                                            still says available: true, because the
#                                            key is valid — only generation fails.
#                                            Top up and it recovers on the next
#                                            click; no deploy, no reload.
#   { "available": true, "configWarning": null }
#                                        → config is good; if it still sounds
#                                            robotic the failure is at generation
#                                            time. In the browser console the
#                                            narrator warns once with the reason,
#                                            and the reading bar carries
#                                            data-narration-voice="premium" or
#                                            "browser". A 403 ORIGIN_NOT_ALLOWED
#                                            there means the docs are served from
#                                            a host that is not the API's host —
#                                            add it to NARRATION_ALLOWED_ORIGINS.
